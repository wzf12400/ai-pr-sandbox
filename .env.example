# Database and service endpoints
DB_URL=jdbc:mysql://127.0.0.1:3306/github_ai_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=root
DB_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
CONTROL_PLANE_URL=http://127.0.0.1:8080
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
AUTOMATION_POLICY_ID=local-development-policy

# AI service
AI_BASE_URL=https://example.invalid/api/v1
AI_API_KEY=
AI_MODEL=ailemac/gpt-5-mini
AI_REVIEW_MODEL=ailemac/gpt-5-mini
AI_SAFETY_IDENTIFIER=
AI_TIMEOUT_SECONDS=60
AI_MAX_COMPLETION_TOKENS=1800
AI_API_MODE=strict
AI_CHAT_ENABLED=true
AI_ASYNC_REPLY=true

# GitHub and Jira credentials
GITHUB_ROUTING_TOKEN=
GITHUB_ISSUE_TOKEN=
GITHUB_COPILOT_TOKEN=
JIRA_BASE_URL=
JIRA_SESSION_COOKIE=
JIRA_USERNAME=
JIRA_PASSWORD=

# Log platform
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TENANT=
OPENSEARCH_DISCOVER_URL=https://example.invalid/_dashboards/app/discover
LOG_SANITIZER_HMAC_KEY=
LOG_INGEST_REQUEST_TIMEOUT_SECONDS=5

# Durable worker queue
WORKER_REDIS_ENABLED=true
WORKER_QUEUE_KEY=github-ai-agent:jobs:v2
WORKER_CONSUMER_GROUP=github-ai-agent-workers
WORKER_DEAD_LETTER_KEY=github-ai-agent:jobs:v2:dead-letter
WORKER_QUEUE_METRICS_KEY=github-ai-agent:jobs:v2:metrics
WORKER_OUTBOX_BATCH_SIZE=100
WORKER_OUTBOX_PUBLISH_DELAY=2s
WORKER_STALE_IDLE_MS=1800000
WORKER_MAX_RETRIES=3
WORKER_DEAD_LETTER_MAX_LENGTH=10000
WORKER_RECONCILIATION_ENABLED=false
WORKER_RECONCILIATION_BATCH_SIZE=100
WORKER_RECONCILIATION_DELAY=5m
WORKER_RECONCILIATION_REPUBLISH_AFTER=10m
WORKER_STALE_TASK_TIMEOUT=30m
WORKER_REQUEST_TIMEOUT_SECONDS=5

# Issue publication
WORKER_AUTHORIZED_REPOSITORY=KikaTech/backend-aicompanion
WORKER_REPOSITORY_PATH=.worker-repos/KikaTech__backend-aicompanion
WORKER_ISSUE_PUBLICATION_ENABLED=false
WORKER_ISSUE_SCOPE_PATH=control-plane/config/repository-search-scope.json
WORKER_ISSUE_POLICY_PATH=control-plane/config/repository-auto-publish-policy.json
WORKER_ISSUE_POLICY_SHA256=2b853c1e8aa2ceceb08124f7909460e23fd2a4ac51b5c994edbeb8ab2283a43d
REPOSITORY_AUTO_POLICY_SHA256=2b853c1e8aa2ceceb08124f7909460e23fd2a4ac51b5c994edbeb8ab2283a43d

# Code execution
WORKER_CODE_MODE=disabled
WORKER_CODE_POLICY_PATH=control-plane/config/code-policies/KikaTech__backend-aicompanion.json
WORKER_CODE_MODEL=
WORKER_CLOUD_AGENT_POLL_INTERVAL_SECONDS=10
WORKER_CLOUD_AGENT_MAX_WAIT_SECONDS=3600
WORKER_GITHUB_TIMEOUT_SECONDS=30
WORKER_CODE_AUDIT_DIR=.worker-audit/control-plane
WORKER_WORKTREES_ROOT=.worker-worktrees
WORKER_CODE_AUTO_APPROVAL_ENABLED=false
WORKER_CODE_AUTO_APPROVAL_POLICY_PATH=control-plane/config/code-preapproval-manifest.json
WORKER_CODE_AUTO_APPROVAL_POLICY_SHA256=329372f4eb0de9bc932efff5c8c13ea6c7cf5d961e50e33723456761cc923e36
