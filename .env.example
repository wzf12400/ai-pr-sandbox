AI_BASE_URL=https://example.invalid/api/v1
AI_API_KEY=replace-locally
AI_MODEL=ailemac/gpt-5-mini
AI_REVIEW_MODEL=ailemac/gpt-5-mini
AI_SAFETY_IDENTIFIER=replace-locally
AI_TIMEOUT_SECONDS=60
AI_MAX_COMPLETION_TOKENS=1800
AI_API_MODE=strict
REPOSITORY_AUTO_POLICY_SHA256=replace-with-reviewed-policy-sha256
OPENSEARCH_USERNAME=replace-with-read-only-user
OPENSEARCH_TENANT=
OPENSEARCH_DISCOVER_URL=https://example.invalid/_dashboards/app/discover#/?_g=(time:(from:now-2h,to:now))&_a=(index:replace-with-data-view-id)
# OPENSEARCH_PASSWORD is intentionally omitted; export it only in the runtime shell
CONTROL_PLANE_URL=http://127.0.0.1:8080
LOG_INGEST_REQUEST_TIMEOUT_SECONDS=5
REDIS_URL=redis://127.0.0.1:6379/0
WORKER_QUEUE_KEY=github-ai-agent:jobs:v2
WORKER_CONSUMER_GROUP=github-ai-agent-workers
WORKER_DEAD_LETTER_KEY=github-ai-agent:jobs:v2:dead-letter
WORKER_QUEUE_METRICS_KEY=github-ai-agent:jobs:v2:metrics
WORKER_STALE_IDLE_MS=1800000
WORKER_MAX_RETRIES=3
WORKER_DEAD_LETTER_MAX_LENGTH=10000
WORKER_RECONCILIATION_ENABLED=false
WORKER_RECONCILIATION_REPUBLISH_AFTER=10m
WORKER_STALE_TASK_TIMEOUT=30m
WORKER_CODE_MODE=disabled
WORKER_CODE_POLICY_PATH=.worker-repos/ai-pr-sandbox/.github/issue-code-policy.json
WORKER_CODE_MODEL=
WORKER_GITHUB_TIMEOUT_SECONDS=30
WORKER_CODE_AUDIT_DIR=.worker-repos/ai-pr-sandbox/.issue-code-output/control-plane
WORKER_CODE_AUTO_APPROVAL_ENABLED=false
WORKER_CODE_AUTO_APPROVAL_POLICY_PATH=control-plane/config/code-execution-preapproval-policy.json
WORKER_CODE_AUTO_APPROVAL_POLICY_SHA256=079c23bb3d1d1af474261311c765712c17df2bf107233cfc7997f65e11014a31
